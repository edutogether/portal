{
  "hosting": {
    "public": "dist",
    "redirects": [
      {
        "source": "/calculator",
        "destination": "https://calc.edutogether.kr",
        "type": 301
      },
      {
        "source": "/calculator/**",
        "destination": "https://calc.edutogether.kr",
        "type": 301
      },
      {
        "source": "/calc",
        "destination": "https://calc.edutogether.kr",
        "type": 301
      },
      {
        "source": "/calc/**",
        "destination": "https://calc.edutogether.kr",
        "type": 301
      },
      {
        "source": "/googler",
        "destination": "https://googler.edutogether.kr",
        "type": 301
      },
      {
        "source": "/googler/**",
        "destination": "https://googler.edutogether.kr",
        "type": 301
      },
      {
        "source": "/classcade",
        "destination": "https://classcade.edutogether.kr",
        "type": 301
      },
      {
        "source": "/classcade/**",
        "destination": "https://classcade.edutogether.kr",
        "type": 301
      },
      {
        "source": "/poster",
        "destination": "https://poster.edutogether.kr",
        "type": 301
      },
      {
        "source": "/poster/**",
        "destination": "https://poster.edutogether.kr",
        "type": 301
      },
      {
        "source": "/voice",
        "destination": "https://voice.edutogether.kr",
        "type": 301
      },
      {
        "source": "/voice/**",
        "destination": "https://voice.edutogether.kr",
        "type": 301
      },
      {
        "source": "/incheon",
        "destination": "https://incheon.edutogether.kr",
        "type": 301
      },
      {
        "source": "/incheon/**",
        "destination": "https://incheon.edutogether.kr",
        "type": 301
      }
    ],
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
